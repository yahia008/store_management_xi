# Copy to .env and adjust. Nothing here is a real secret.

# The Postgres database. `scripts/dev-db.sh` starts one that matches this.
DATABASE_URL=postgres://store:store@127.0.0.1:5433/store

# Where the API listens.
BIND=127.0.0.1:8080

# Sessions: how long a token lives, and how long a quiet session stays valid.
# Business owners and administrators always use the shorter ADMIN idle limit (SRS NFR-17: 15 minutes).
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
ADMIN_SESSION_IDLE_MINUTES=15

# Sign-in protection (SRS NFR-16): lock an account for a while after this many wrong passwords in a row.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# How long a password-reset link stays valid.
RESET_TOKEN_TTL_MINUTES=30

# Development only: print password-reset tokens to the log so you can finish a reset without email.
# Never set this to true on a real server.
DEV_PRINT_RESET_TOKENS=false

# Returns after this many days, or refunds above this amount (minor units), need a store manager.
RETURN_WINDOW_DAYS=30
RETURN_MANAGER_LIMIT_MINOR=5000000

# A cashier can discount a line by up to this many basis points (1000 = 10%); more needs a store manager.
CASHIER_MAX_DISCOUNT_BPS=1000

RUST_LOG=info,store_api=debug
